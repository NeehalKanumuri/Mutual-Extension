{
  "manifest_version": 3,
  "name": "The Mutual — Behavioral Alignment & Delegation Handshake",
  "short_name": "The Mutual",
  "version": "1.1.0",
  "description": "Real-time ambiguity interceptor, 5-point micro-contracts, and pre-flight delivery checks — works on Google Meet, Zoom, Microsoft Teams, Slack Huddles, and more.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open The Mutual Side Panel"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "offscreen",
    "tabs"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+M",
        "mac": "Alt+M"
      },
      "description": "Toggle The Mutual Side Panel"
    }
  },
  "host_permissions": [
    "https://meet.google.com/*",
    "https://app.zoom.us/*",
    "https://zoom.us/*",
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://app.slack.com/*",
    "https://chat.google.com/*",
    "https://docs.google.com/document/*",
    "https://www.notion.so/*",
    "https://mail.google.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://emmrksahudinowrgbjnw.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js":      ["content-meet.js"],
      "run_at":  "document_idle"
    },
    {
      "matches": ["https://app.zoom.us/*", "https://zoom.us/wc/*"],
      "js":      ["content-zoom.js"],
      "run_at":  "document_idle"
    },
    {
      "matches": ["https://teams.microsoft.com/*", "https://teams.live.com/*"],
      "js":      ["content-teams.js"],
      "run_at":  "document_idle"
    },
    {
      "matches": ["https://app.slack.com/*"],
      "js":      ["content-slack.js"],
      "run_at":  "document_idle"
    },
    {
      "matches": [
        "https://docs.google.com/document/*",
        "https://www.notion.so/*",
        "https://mail.google.com/*",
        "https://chat.google.com/*"
      ],
      "js":     ["content-doc.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "requestPermissions.html",
        "requestPermissions.js",
        "permission.html",
        "permission.js",
        "offscreen.html",
        "sidepanel.html",
        "supabase-client.js",
        "audiowave.mp4"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
